[
  {
    "name": "deepseek",
    "hostname": "chat.deepseek.com",
    "label": "Официальный сайт DeepSeek",
    "api": ["/api/v0/chat/completion", "/api/v0/chat/edit_message"],
    "promptPath": "prompt",
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["v"],
      "filterRules": {
        "pathField": "p",
        "excludePatterns": ["fragments/0/content"]
      }
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": ".ds-message",
      "messageIndex": -1,
      "contentSelector": ".ds-markdown",
      "senderSelector": ".ds-message:not(:has(.ds-markdown)) div"
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    }
  },
  {
    "name": "yuanbao",
    "hostname": "yuanbao.tencent.com",
    "label": "Tencent Yuanbao",
    "api": ["/api/chat/"],
    "promptPath": ["prompt", "displayPrompt"],
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["msg"]
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": ".hyc-content-md",
      "messageIndex": -1,
      "contentSelector": ".hyc-common-markdown",
      "senderSelector": ".hyc-content-text"
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 2000
    },
    "newConversationFlag": {
      "from": "requestBody",
      "path": "chatModelExtInfo",
      "checkExists": true,
      "checkValue": null,
      "valueType": null
    }
  },
  {
    "name": "tongyi",
    "hostname": "www.tongyi.com",
    "label": "Tongyi Qianwen",
    "api": ["/dialog/conversation"],
    "promptPath": "contents.0.content",
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["content", "text", "delta"]
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": ".tongyi-markdown",
      "messageIndex": -1,
      "contentSelector": "",
      "senderSelector": "div[class^='questionItem-'] div[class^='bubble-']"
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    }
  },
  {
    "name": "chatgpt",
    "hostname": "chatgpt.com",
    "label": "ChatGPT",
    "api": ["/backend-api/conversation", "/backend-anon/conversation", "/backend-api/f/conversation"],
    "promptPath": "messages.0.content.parts.0",
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["message.content.parts.0", "delta.content", "content"]
    },
    "input": {
      "selector": "#prompt-textarea",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    }
  },
  {
    "name": "doubao",
    "hostname": "www.doubao.com",
    "label": "Doubao",
    "api": ["/samantha/chat/completion"],
    "promptPath": "messages.0.content.text",
    "isJsonString": true,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["choices.0.delta.content", "delta.content", "content"]
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": "div[data-testid=\"receive_message\"] div[data-testid=\"message_text_content\"]",
      "messageIndex": -1,
      "contentSelector": "",
      "senderSelector": "div[data-testid=\"send_message\"] div[data-testid=\"message_text_content\"]"
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    },
    "newConversationFlag": {
      "from": "requestBody",
      "path": "conversation_id",
      "checkValue": "0",
      "valueType": "string"
    }
  },
  {
    "name": "grok",
    "hostname": "grok.com",
    "label": "Grok",
    "api": ["/rest/app-chat/conversations"],
    "promptPath": "message",
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["content", "text", "message"]
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    }
  },
  {
    "name": "google_aistudio",
    "hostname": "aistudio.google.com",
    "label": "Google AI Studio",
    "api": ["/GenerateContent"],
    "promptPath": "message",
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "skipRequestModification": true,
    "response": {
      "type": "json",
      "format": "{json}",
      "contentPaths": ["content", "text", "message"]
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": ["Ctrl"],
      "submitDelay": 1600
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": "ms-chat-turn",
      "messageIndex": -1,
      "contentSelector": ""
    },
    "onLoadTip": {
      "message": [
        "Google AI Studio не поддерживает автоматическую инъекцию System Prompt",
        "",
        "После каждого создания нового диалога нажмите «Обновить System Prompt» на панели плагина, чтобы вручную внедрить содержимое System Prompt",
        "Кроме того, этот сайт не поддерживает автоматическое чтение ответов инструментов модели. В плавающем окне в правом нижнем углу нажмите на иконку часов для ручного распознавания"
      ],
      "dontShowAgainText": "Больше не показывать это уведомление"
    }
  },
  {
    "name": "qianwen",
    "hostname": "www.qianwen.com",
    "label": "Tongyi Qianwen",
    "api": ["/dialog/conversation", "api/v2/chat"],
    "promptPath": ["messages.0.content", "messages.0.meta_data.ori_query"],
    "isJsonString": false,
    "enabled": true,
    "defaultAlwaysInject": true,
    "response": {
      "type": "sse",
      "format": "data: {json}",
      "contentPaths": ["content", "text", "delta"]
    },
    "uiParsing": {
      "enabled": true,
      "priority": "ui",
      "messageContainer": [".tongyi-markdown", "#qk-markdown-react"],
      "messageIndex": -1,
      "contentSelector": "",
      "senderSelector": "div[class^='questionItem-'] div[class^='bubble-']"
    },
    "input": {
      "selector": "textarea, [contenteditable='true']",
      "submitKey": "Enter",
      "submitModifiers": [],
      "submitDelay": 1600
    },
    "newConversationFlag": {
      "from": "requestBody",
      "path": "scene_param",
      "checkValue": "first_turn",
      "valueType": "string",
      "checkExists": true
    },
    "promptFilter": {
      "preset": "findByField",
      "params": {
        "arrayPath": "messages",
        "matchField": "mime_type",
        "matchValue": "text/plain",
        "returnField": "content"
      }
    },
    "promptSetFilter": {
      "preset": "setByField",
      "params": {
        "arrayPath": "messages",
        "matchField": "mime_type",
        "matchValue": "text/plain",
        "setField": ["content", "meta_data.ori_query"]
      }
    }
  }
]